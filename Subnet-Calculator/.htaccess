# -----------------------------------------------------------------------
# Subnet Calculator — .htaccess
# Compatible with: Apache 2.4+, OpenLiteSpeed
#
# Apache 2.4 uses mod_authz_core (<Files> + Require all denied).
# OpenLiteSpeed honours RewriteRule [F] but has incomplete support for
# mod_authz_core directives, so both mechanisms are always present.
# -----------------------------------------------------------------------

# -----------------------------------------------------------------------
# Block sensitive files
# config.php          — live config with operator secrets
# config.php.example  — reveals configuration surface
# -----------------------------------------------------------------------
<Files "config.php">
    Require all denied
</Files>

<Files "config-admin.php">
    Require all denied
</Files>

<Files "config.php.example">
    Require all denied
</Files>

# -----------------------------------------------------------------------
# Block deployment artefacts that a user might leave in the docroot
# after extracting a release tarball.
# -----------------------------------------------------------------------
<FilesMatch "\.(tar\.gz|tar|gz|zip)$">
    Require all denied
</FilesMatch>

# CHANGELOG.md is bundled in tarballs for the /api/v1/changelog endpoint;
# block direct HTTP access so the raw file is not publicly readable.
<Files "CHANGELOG.md">
    Require all denied
</Files>

# -----------------------------------------------------------------------
# OpenLiteSpeed / LiteSpeed fallback (RewriteRule [F] is widely supported)
# -----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Sensitive config files
    RewriteRule ^config\.php$         - [F,L]
    RewriteRule ^config-admin\.php$   - [F,L]
    RewriteRule ^config\.php\.example$ - [F,L]
    RewriteRule ^CHANGELOG\.md$       - [F,L]

    # Deployment artefacts
    RewriteRule \.(tar\.gz|tar|gz|zip)$ - [F,L]

    # Protect PHP source subdirectories — assets/ is intentionally public
    # Belt-and-suspenders: each subdirectory also has its own .htaccess
    RewriteRule ^(includes|templates)/ - [F,L]

    # Block session database directory and API internals
    RewriteRule ^data/ - [F,L]
    RewriteRule ^api/v1/handlers/ - [F,L]

    # v3.4.0: per-tool URL routes — back-compat with ?tab=&tool=
    # /ipv4/<tool> and /ipv6/<tool> rewrite to index.php?tab=&tool=
    # The !-f / !-d guards prevent clobbering real assets that match the pattern.
    # QSA preserves shareable query params (e.g. ?address=…). L stops further rewrite.
    # Legacy ?tab=&tool= URLs continue to be accepted as input with no redirect
    # (iframe and bookmark back-compat).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(ipv4|ipv6)/([a-z0-9-]+)/?$ index.php?tab=$1&tool=$2 [QSA,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(ipv4|ipv6)/?$ index.php?tab=$1 [QSA,L]
</IfModule>

# Block SQLite database files and API internals regardless of location
# (FilesMatch works on Apache and OpenLiteSpeed)
<FilesMatch "\.sqlite$">
    Require all denied
</FilesMatch>

<FilesMatch "^helpers\.php$">
    Require all denied
</FilesMatch>

# -----------------------------------------------------------------------
# Cache-control for static assets
# Apache: mod_expires + mod_headers
# OLS:    honours Expires/Cache-Control headers from mod_expires/mod_headers
# -----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp               "access plus 1 year"
    ExpiresByType image/png                "access plus 1 year"
    ExpiresByType image/svg+xml            "access plus 1 year"
    ExpiresByType text/css                 "access plus 1 year"
    ExpiresByType application/javascript   "access plus 1 year"
    ExpiresByType text/javascript          "access plus 1 year"
    ExpiresByType font/woff2               "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(webp|png|svg|css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Service Worker must not be long-cached — browser needs to check for updates on every load
    <Files "sw.js">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Service-Worker-Allowed "/"
    </Files>
</IfModule>
